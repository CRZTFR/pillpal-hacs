{
  "contract": "device-v2",
  "version": 1,
  "description": "Resolving a schedule to occurrence windows. `openAt` asks for the window open at an instant; `nextFrom` asks for the first window starting at or after one. Synthetic transitions keep the daylight-saving cases independent of any country's current law; the Australian zones are real, because Australia is a launch market and its daylight period wraps the new year, which is the case a northern-hemisphere-only zone never exercises. Australian expectations were derived from the IANA database, not from any implementation here.",
  "zones": {
    "utc": "UTC0",
    "synthetic": "TST0TDT,M3.1.0,M11.1.0",
    "sydney": "AEST-10AEDT,M10.1.0,M4.1.0/3",
    "adelaide": "ACST-9:30ACDT,M10.1.0,M4.1.0/3",
    "brisbane": "AEST-10",
    "perth": "AWST-8"
  },
  "cases": [
    {
      "id": "daily-next-window",
      "scenario": "REM-01",
      "zone": "utc",
      "schedule": {
        "id": 1,
        "recurrence": "daily",
        "time": "08:00",
        "durationMinutes": 60
      },
      "nextFrom": {
        "local": "2026-09-16T07:00:00",
        "offsetMinutes": 0
      },
      "expect": {
        "found": true,
        "start": {
          "local": "2026-09-16T08:00:00",
          "offsetMinutes": 0
        },
        "end": {
          "local": "2026-09-16T09:00:00",
          "offsetMinutes": 0
        },
        "scheduledLocal": "2026-09-16T08:00:00",
        "resolution": "exact"
      }
    },
