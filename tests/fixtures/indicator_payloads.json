{
  "contract": "device-v2",
  "version": 1,
  "description": "Indicator payloads (indicators.md): each case is the payload of a transient command that has passed admission. 'valid' cases give the canonical form the lamp stores and reports, with defaults filled in and absent optional fields as null. 'invalid_payload' is a value outside the rules; 'malformed' is a field of the wrong type, marked dynamicOnly because a statically typed client cannot construct it. 'not_permitted' is the one permission question only the payload can answer. holder is the sender's grant kind.",
  "lamp": {
    "now": 1789635600000
  },
  "integrationGrantId": 9,
  "cases": [
    {
      "id": "notify-pulse",
      "operation": "notify",
      "holder": "phone",
      "payload": {
        "pattern": "pulse",
        "colour": "#00FF00",
        "durationSeconds": 5
      },
      "expect": "valid",
      "canonical": {
        "pattern": "pulse",
        "colour": "#00ff00",
        "durationSeconds": 5
      },
      "note": "Colours are canonical in lower case."
    },
